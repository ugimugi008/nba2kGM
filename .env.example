# Party Code multiplayer needs shared storage when deployed (Vercel, multiple servers).
# Local `npm run dev` works without any of these (rooms are kept in memory).
#
# Option A — Upstash Redis REST (Vercel → Storage → "Upstash for Redis" sets these for you)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are also accepted)
#
# Option B — any Redis over TCP
# REDIS_URL=redis://default:password@host:6379
