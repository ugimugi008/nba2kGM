{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/api/party/:code/:action",
      "destination": "/api/party?code=:code&action=:action"
    },
    {
      "source": "/api/party/:code",
      "destination": "/api/party?code=:code"
    }
  ]
}
